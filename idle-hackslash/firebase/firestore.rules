rules_version = '2';
// 無限反射（放置ハクスラ）のセーブの控え
// users/<uid> は、その本人（ログインしている人の uid が同じ）だけが読み書きできる。ほかの人のセーブは見られない
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['save', 'saveAt', 'saveBest', 'saveReb', 'saveStage'])
        && (request.resource.data.save == null || (request.resource.data.save is string && request.resource.data.save.size() < 240000));
    }
    match /{document=**} {
      allow read, write: if false; // それ以外は誰も読み書きできない
    }
  }
}
